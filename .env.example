# Django signing key. Generate a unique random value for each deployment.
SECRET_KEY=change-me-use-at-least-50-random-characters-in-production
# Use False in production. True selects development settings via config.settings.
DEBUG=False
# Comma-separated hostnames accepted by Django (no schemes).
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL database name and least-privilege application credentials.
DB_NAME=shahm
DB_USER=shahm
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Browser-facing frontend origin, backend origin, and canonical public website URL.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SITE_URL=http://localhost:3000
# Comma-separated full origins, including scheme and port where applicable.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Disabled by default. Enable only for a controlled initial-admin bootstrap.
ENABLE_INITIAL_ADMIN_SETUP=False

# Shared cache used by rate limiting and account lockout counters. The default
# is per-process; any deployment with more than one worker must set a shared
# backend, for example rediscache://127.0.0.1:6379/1 or
# pymemcache://127.0.0.1:11211. `check --deploy` warns while it is unset.
CACHE_URL=locmemcache://

# Application log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Consecutive failed sign-in attempts for one account before it is locked, and
# the lock duration in seconds.
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900

# Optional rate overrides, written as "<count>/<period>" where period is
# s, min, hour or day. Defaults are shown; delete a line to keep its default.
# THROTTLE_LOGIN=10/min
# THROTTLE_OTP=5/min
# THROTTLE_OTP_SEND=5/min
# THROTTLE_OTP_VERIFY=10/min
# THROTTLE_SEARCH=30/min
# THROTTLE_CONTACT=5/min
# THROTTLE_SUBSCRIBE=5/min
# THROTTLE_FORM_SUBMIT=10/min
# THROTTLE_PUBLIC_EDIT=10/min
